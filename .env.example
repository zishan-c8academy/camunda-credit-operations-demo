# Copy this file to .env and fill it in. .env is ignored by git: never commit it.

# --- 1. Cluster credentials -------------------------------------------------------------------------------------
# Easiest: paste the whole "Env Vars" block that Camunda Console shows when you create an API client
# (cluster > API > Create new client, scope "Orchestration Cluster API"). "export" prefixes and quotes are fine.
# The scripts need at least these:
CAMUNDA_CLUSTER_ID=
CAMUNDA_CLUSTER_REGION=
ZEEBE_REST_ADDRESS=
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
CAMUNDA_OAUTH_URL=https://login.cloud.camunda.io/oauth/token

# --- 2. LLM endpoint the agents call ----------------------------------------------------------------------------
# Any OpenAI-compatible chat completions API that accepts an API key: OpenAI, OpenRouter, or your own AI gateway.
# setup.py writes these two values into the cluster variable CB_GENAI. The key itself is NOT stored here:
# create it in Console as the connector secret CB_LLM_API_KEY (README, step 3).
# Tested with: endpoint https://openrouter.ai/api/v1 (EU host: https://eu.openrouter.ai/api/v1), model anthropic/claude-sonnet-5
CB_LLM_ENDPOINT=
CB_LLM_MODEL=

# --- 3. Optional ------------------------------------------------------------------------------------------------
# CB_PORT=5690                       port for the workbench
# CB_LLM_SECRET_NAME=CB_LLM_API_KEY  only if your connector secret has a different name; then rerun scripts/setup.py
