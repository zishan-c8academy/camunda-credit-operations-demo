<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_CB_RuleImprovement" targetNamespace="http://camunda.org/schema/1.0/bpmn" exporter="cb-camunda-demo build.py" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
<bpmn:error id="Err_CiOffRail" name="Agent off the rails" errorCode="AGENT_OFF_RAIL" />
<bpmn:process id="CB_RuleImprovement" name="Continuous improvement: tune the approval authority rule" isExecutable="true"><bpmn:documentation>Observe, decide, execute, learn. Reads how analysts decided on AI recommendations, proposes one bounded change, a rule owner approves, and a new decision version deploys with no code change.</bpmn:documentation>
<bpmn:startEvent id="ReviewRequested" name="Improvement review requested"><bpmn:outgoing>Flow_ReviewRequested_StartMerge</bpmn:outgoing></bpmn:startEvent>
<bpmn:startEvent id="WeeklyReview" name="Every Monday 06:00"><bpmn:outgoing>Flow_WeeklyReview_StartMerge</bpmn:outgoing><bpmn:timerEventDefinition id="WeeklyReview_def"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 6 * * MON</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:exclusiveGateway id="StartMerge" name=""><bpmn:incoming>Flow_ReviewRequested_StartMerge</bpmn:incoming><bpmn:incoming>Flow_WeeklyReview_StartMerge</bpmn:incoming><bpmn:outgoing>Flow_StartMerge_ImprovementAgent</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:adHocSubProcess id="ImprovementAgent" name="Improvement analyst agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,"><bpmn:extensionElements><zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" /><zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="3" /><zeebe:ioMapping><zeebe:input source="openai" target="provider.type" /><zeebe:input source="completions" target="provider.openai.api.type" /><zeebe:input source="custom" target="provider.openai.backend.type" /><zeebe:input source="=camunda.vars.env.CB_GENAI.endpoint" target="provider.openai.backend.custom.endpoint" /><zeebe:input source="apiKey" target="provider.openai.backend.custom.authentication.type" /><zeebe:input source="{{secrets.CB_LLM_API_KEY}}" target="provider.openai.backend.custom.authentication.apiKey" /><zeebe:input source="=if is defined(modelOverride) and modelOverride != null then modelOverride else camunda.vars.env.CB_GENAI.model" target="provider.openai.model.model" /><zeebe:input source="modelDefault" target="provider.openai.api.completions.effort" /><zeebe:input source="=4096" target="provider.openai.api.completions.maxCompletionTokens" /><zeebe:input source="PT90S" target="provider.openai.timeouts.timeout" /><zeebe:input source="=camunda.vars.env.CB_PROMPTS.ruleImprovement.text" target="data.systemPrompt.prompt" /><zeebe:input source="=&quot;Review the approval authority table CB_DisputeApprovalAuthority. Current autoApplyMinConfidence: &quot; + string(camunda.vars.env.CB_POLICY.autoApplyMinConfidence) + &quot;.&quot;" target="data.userPrompt.prompt" /><zeebe:input source="=improvementAgent.context" target="agentContext" /><zeebe:input source="in-process" target="data.memory.storage.type" /><zeebe:input source="=30" target="data.memory.contextWindowSize" /><zeebe:input source="=if is defined(maxModelCallsOverride) and maxModelCallsOverride != null then maxModelCallsOverride else 10" target="data.limits.maxModelCalls" /><zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" /><zeebe:input source="text" target="data.response.format.type" /><zeebe:input source="=true" target="data.response.format.parseJson" /><zeebe:input source="=false" target="data.response.includeAssistantMessage" /><zeebe:input source="=true" target="data.response.includeAgentContext" /><zeebe:input target="agent" /><zeebe:output source="=agent" target="improvementAgent" /><zeebe:output source="=if agent.responseJson != null then agent.responseJson else if agent.responseText != null then from json(replace(replace(agent.responseText, &quot;^\s*```(json)?\s*&quot;, &quot;&quot;), &quot;\s*```\s*$&quot;, &quot;&quot;)) else null" target="proposal" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="1" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" /><zeebe:header key="retryBackoff" value="PT10S" /><zeebe:header key="errorExpression" value="=if error != null and (error.code = &quot;MAXIMUM_NUMBER_OF_MODEL_CALLS_REACHED&quot; or error.code = &quot;FAILED_TO_PARSE_RESPONSE_CONTENT&quot; or error.code = &quot;MODEL_RESPONSE_GUARDRAIL_INTERVENED&quot; or error.code = &quot;MODEL_CONTEXT_WINDOW_EXCEEDED&quot;) then bpmnError(&quot;AGENT_OFF_RAIL&quot;, error.message, {agentErrorCode: error.code}) else null" /></zeebe:taskHeaders><zeebe:properties><zeebe:property name="io.camunda.agenticai.toolContainer" value="true" /></zeebe:properties><zeebe:agentDefinition agentType="aiAgentSubProcess" /></bpmn:extensionElements><bpmn:incoming>Flow_StartMerge_ImprovementAgent</bpmn:incoming><bpmn:outgoing>Flow_ImprovementAgent_ValidateProposal</bpmn:outgoing>
<bpmn:scriptTask id="ReadChangePolicy" name="Read change policy"><bpmn:documentation>Returns the parameters of the authority table that may be tuned, their limits and the maximum step per release.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=camunda.vars.env.CB_POLICY" resultVariable="toolCallResult" /></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:serviceTask id="GetOverrideStats" name="Get override statistics"><bpmn:documentation>Returns, per confidence band and dispute type, how many cases analysts approved and overrode, from completed disputes in Operate.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="cb.learn.stats" retries="3" /></bpmn:extensionElements></bpmn:serviceTask>
<bpmn:serviceTask id="BacktestThreshold" name="Backtest threshold"><bpmn:documentation>Replays completed disputes against a candidate autoApplyMinConfidence and returns how many would have auto-applied and how many of those an analyst overrode.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="cb.learn.backtest" retries="3" /><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.candidateValue, &quot;Candidate autoApplyMinConfidence, for example 0.85&quot;, &quot;number&quot;)" target="candidateValue" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:serviceTask>
</bpmn:adHocSubProcess>
<bpmn:boundaryEvent id="CiOffRail" name="Agent off rail" attachedToRef="ImprovementAgent"><bpmn:outgoing>Flow_CiOffRail_CiStopped</bpmn:outgoing><bpmn:errorEventDefinition id="CiOffRail_def" errorRef="Err_CiOffRail" /></bpmn:boundaryEvent>
<bpmn:endEvent id="CiStopped" name="No proposal"><bpmn:incoming>Flow_CiOffRail_CiStopped</bpmn:incoming></bpmn:endEvent>
<bpmn:scriptTask id="ValidateProposal" name="Check proposal against change policy"><bpmn:extensionElements><zeebe:script expression="={ok: proposal.change = true and proposal.proposedValue &gt;= camunda.vars.env.CB_POLICY.limits.min and proposal.proposedValue &lt;= camunda.vars.env.CB_POLICY.limits.max and abs(proposal.proposedValue - camunda.vars.env.CB_POLICY.autoApplyMinConfidence) &lt;= camunda.vars.env.CB_POLICY.limits.maxStep and get or else(proposal.backtest.overriddenAmongAffected, 1) = 0, checkedAgainst: &quot;CB_POLICY limits &quot; + string(camunda.vars.env.CB_POLICY.limits.min) + &quot; to &quot; + string(camunda.vars.env.CB_POLICY.limits.max) + &quot;, max step &quot; + string(camunda.vars.env.CB_POLICY.limits.maxStep)}" resultVariable="validation" /></bpmn:extensionElements><bpmn:incoming>Flow_ImprovementAgent_ValidateProposal</bpmn:incoming><bpmn:outgoing>Flow_ValidateProposal_ValidGw</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="ValidGw" name="Within policy?" default="Flow_Invalid"><bpmn:incoming>Flow_ValidateProposal_ValidGw</bpmn:incoming><bpmn:outgoing>Flow_ValidGw_RuleOwnerReview</bpmn:outgoing><bpmn:outgoing>Flow_Invalid</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="NoChange" name="No change"><bpmn:incoming>Flow_Invalid</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="RuleOwnerReview" name="Rule owner approves change"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="CB_RuleChangeApprovalForm" /><zeebe:assignmentDefinition candidateGroups="rule-owners" /><zeebe:priorityDefinition priority="=70" /><zeebe:ioMapping><zeebe:input source="=proposal.parameter" target="parameterShown" /><zeebe:input source="=string(proposal.currentValue)" target="currentShown" /><zeebe:input source="=string(proposal.proposedValue)" target="proposedShown" /><zeebe:input source="=proposal.rationale" target="rationaleShown" /><zeebe:input source="=&quot;Cases affected: &quot; + string(proposal.backtest.casesAffected) + &quot;. Overridden among them: &quot; + string(proposal.backtest.overriddenAmongAffected)" target="backtestShown" /><zeebe:input source="=proposal.risk" target="riskShown" /><zeebe:output source="=ruleOwnerDecision" target="ruleOwnerDecision" /><zeebe:output source="=get or else(ruleOwnerComments, &quot;&quot;)" target="ruleOwnerComments" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_ValidGw_RuleOwnerReview</bpmn:incoming><bpmn:outgoing>Flow_RuleOwnerReview_ApprovedGw</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="ApprovedGw" name="Approved?" default="Flow_Rejected"><bpmn:incoming>Flow_RuleOwnerReview_ApprovedGw</bpmn:incoming><bpmn:outgoing>Flow_ApprovedGw_DeployDecision</bpmn:outgoing><bpmn:outgoing>Flow_Rejected</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="DeployDecision" name="Deploy new decision version"><bpmn:documentation>Writes the authority table with the approved value and deploys it as a new version. The previous version stays for in-flight cases and rollback.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="cb.learn.deploy" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_ApprovedGw_DeployDecision</bpmn:incoming><bpmn:outgoing>Flow_DeployDecision_RecogniseContributors</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="RecogniseContributors" name="Recognise contributing analysts"><bpmn:extensionElements><zeebe:taskDefinition type="cb.achievement.publish" retries="3" /><zeebe:ioMapping><zeebe:input source="=&quot;IMPROVEMENT_ADOPTED&quot;" target="eventType" /><zeebe:input source="=get or else(proposal.creditTo, &quot;Dispute analysts team&quot;)" target="employee" /><zeebe:input source="=true" target="withinSla" /><zeebe:input source="=&quot;CB_DisputeApprovalAuthority v&quot; + string(deployedVersion)" target="sourceRef" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_DeployDecision_RecogniseContributors</bpmn:incoming><bpmn:outgoing>Flow_RecogniseContributors_NewVersionLive</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="NewVersionLive" name="New rule version live"><bpmn:incoming>Flow_RecogniseContributors_NewVersionLive</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="ChangeRejected" name="Change rejected"><bpmn:incoming>Flow_Rejected</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_ReviewRequested_StartMerge" sourceRef="ReviewRequested" targetRef="StartMerge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_WeeklyReview_StartMerge" sourceRef="WeeklyReview" targetRef="StartMerge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_StartMerge_ImprovementAgent" sourceRef="StartMerge" targetRef="ImprovementAgent"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ImprovementAgent_ValidateProposal" sourceRef="ImprovementAgent" targetRef="ValidateProposal"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_CiOffRail_CiStopped" sourceRef="CiOffRail" targetRef="CiStopped"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ValidateProposal_ValidGw" sourceRef="ValidateProposal" targetRef="ValidGw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ValidGw_RuleOwnerReview" name="Yes" sourceRef="ValidGw" targetRef="RuleOwnerReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validation.ok</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Invalid" name="No" sourceRef="ValidGw" targetRef="NoChange"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_RuleOwnerReview_ApprovedGw" sourceRef="RuleOwnerReview" targetRef="ApprovedGw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ApprovedGw_DeployDecision" name="Approve" sourceRef="ApprovedGw" targetRef="DeployDecision"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ruleOwnerDecision = "APPROVE"</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Rejected" name="Reject" sourceRef="ApprovedGw" targetRef="ChangeRejected"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_DeployDecision_RecogniseContributors" sourceRef="DeployDecision" targetRef="RecogniseContributors"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_RecogniseContributors_NewVersionLive" sourceRef="RecogniseContributors" targetRef="NewVersionLive"></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_CB_RuleImprovement"><bpmndi:BPMNPlane id="Plane_CB_RuleImprovement" bpmnElement="CB_RuleImprovement">
<bpmndi:BPMNShape id="ReviewRequested_di" bpmnElement="ReviewRequested"><dc:Bounds x="72" y="232" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="35" y="272" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="WeeklyReview_di" bpmnElement="WeeklyReview"><dc:Bounds x="72" y="402" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="35" y="442" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="StartMerge_di" bpmnElement="StartMerge"><dc:Bounds x="155" y="305" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ImprovementAgent_di" bpmnElement="ImprovementAgent" isExpanded="true"><dc:Bounds x="260" y="150" width="420" height="330" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ReadChangePolicy_di" bpmnElement="ReadChangePolicy"><dc:Bounds x="285" y="210" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="GetOverrideStats_di" bpmnElement="GetOverrideStats"><dc:Bounds x="415" y="210" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="BacktestThreshold_di" bpmnElement="BacktestThreshold"><dc:Bounds x="545" y="210" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="CiOffRail_di" bpmnElement="CiOffRail"><dc:Bounds x="622" y="462" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="585" y="502" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="CiStopped_di" bpmnElement="CiStopped"><dc:Bounds x="622" y="562" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="585" y="602" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ValidateProposal_di" bpmnElement="ValidateProposal"><dc:Bounds x="725" y="290" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ValidGw_di" bpmnElement="ValidGw"><dc:Bounds x="875" y="305" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="845" y="271" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="NoChange_di" bpmnElement="NoChange"><dc:Bounds x="882" y="502" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="845" y="542" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="RuleOwnerReview_di" bpmnElement="RuleOwnerReview"><dc:Bounds x="975" y="290" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ApprovedGw_di" bpmnElement="ApprovedGw"><dc:Bounds x="1135" y="305" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1105" y="271" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="DeployDecision_di" bpmnElement="DeployDecision"><dc:Bounds x="1235" y="290" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="RecogniseContributors_di" bpmnElement="RecogniseContributors"><dc:Bounds x="1365" y="290" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="NewVersionLive_di" bpmnElement="NewVersionLive"><dc:Bounds x="1532" y="312" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1495" y="352" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ChangeRejected_di" bpmnElement="ChangeRejected"><dc:Bounds x="1142" y="502" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1105" y="542" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Flow_ReviewRequested_StartMerge_di" bpmnElement="Flow_ReviewRequested_StartMerge"><di:waypoint x="108" y="250" /><di:waypoint x="180" y="250" /><di:waypoint x="180" y="305" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_WeeklyReview_StartMerge_di" bpmnElement="Flow_WeeklyReview_StartMerge"><di:waypoint x="108" y="420" /><di:waypoint x="180" y="420" /><di:waypoint x="180" y="355" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_StartMerge_ImprovementAgent_di" bpmnElement="Flow_StartMerge_ImprovementAgent"><di:waypoint x="205" y="330" /><di:waypoint x="260" y="330" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_ImprovementAgent_ValidateProposal_di" bpmnElement="Flow_ImprovementAgent_ValidateProposal"><di:waypoint x="680" y="330" /><di:waypoint x="725" y="330" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_CiOffRail_CiStopped_di" bpmnElement="Flow_CiOffRail_CiStopped"><di:waypoint x="640" y="498" /><di:waypoint x="640" y="562" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_ValidateProposal_ValidGw_di" bpmnElement="Flow_ValidateProposal_ValidGw"><di:waypoint x="835" y="330" /><di:waypoint x="875" y="330" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_ValidGw_RuleOwnerReview_di" bpmnElement="Flow_ValidGw_RuleOwnerReview"><di:waypoint x="925" y="330" /><di:waypoint x="975" y="330" /><bpmndi:BPMNLabel><dc:Bounds x="933" y="308" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_Invalid_di" bpmnElement="Flow_Invalid"><di:waypoint x="900" y="355" /><di:waypoint x="900" y="502" /><bpmndi:BPMNLabel><dc:Bounds x="906" y="418" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_RuleOwnerReview_ApprovedGw_di" bpmnElement="Flow_RuleOwnerReview_ApprovedGw"><di:waypoint x="1085" y="330" /><di:waypoint x="1135" y="330" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_ApprovedGw_DeployDecision_di" bpmnElement="Flow_ApprovedGw_DeployDecision"><di:waypoint x="1185" y="330" /><di:waypoint x="1235" y="330" /><bpmndi:BPMNLabel><dc:Bounds x="1193" y="308" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected"><di:waypoint x="1160" y="355" /><di:waypoint x="1160" y="502" /><bpmndi:BPMNLabel><dc:Bounds x="1166" y="418" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_DeployDecision_RecogniseContributors_di" bpmnElement="Flow_DeployDecision_RecogniseContributors"><di:waypoint x="1345" y="330" /><di:waypoint x="1365" y="330" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_RecogniseContributors_NewVersionLive_di" bpmnElement="Flow_RecogniseContributors_NewVersionLive"><di:waypoint x="1475" y="330" /><di:waypoint x="1532" y="330" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
