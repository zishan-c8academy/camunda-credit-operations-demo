<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_CB_IncidentManagement" targetNamespace="http://camunda.org/schema/1.0/bpmn" exporter="cb-camunda-demo build.py" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
<bpmn:error id="Err_TriageOffRail" name="Agent off the rails" errorCode="AGENT_OFF_RAIL" />
<bpmn:process id="CB_IncidentManagement" name="Incident management with AI triage" isExecutable="true"><bpmn:documentation>A monitoring alert arrives by webhook. An AI agent triages; a severity matrix sets the priority and SLAs; responders acknowledge or the escalation ladder runs. Incidents on the dispute service flag the statutory clocks of open disputes.</bpmn:documentation>
<bpmn:startEvent id="AlertReceived" name="Monitoring alert received (webhook)" zeebe:modelerTemplate="io.camunda.connectors.webhook.WebhookConnector.v1" zeebe:modelerTemplateVersion="14"><bpmn:extensionElements><zeebe:properties><zeebe:property name="inbound.type" value="io.camunda:webhook:1" /><zeebe:property name="inbound.subtype" value="ConfigurableInboundWebhook" /><zeebe:property name="inbound.method" value="post" /><zeebe:property name="inbound.context" value="cb-monitoring-alert" /><zeebe:property name="inbound.shouldValidateHmac" value="disabled" /><zeebe:property name="inbound.auth.type" value="NONE" /><zeebe:property name="resultExpression" value="={alert: request.body, incidentId: request.body.incidentId, service: request.body.service}" /><zeebe:property name="inbound.responseExpression" value="={body: {accepted: true, incidentId: request.body.incidentId}, statusCode: 202}" /><zeebe:property name="deduplicationModeManualFlag" value="false" /><zeebe:property name="deduplicationMode" value="AUTO" /><zeebe:property name="consumeUnmatchedEvents" value="true" /></zeebe:properties></bpmn:extensionElements><bpmn:outgoing>Flow_AlertReceived_LookUpService</bpmn:outgoing></bpmn:startEvent>
<bpmn:scriptTask id="LookUpService" name="Look up service in CMDB"><bpmn:extensionElements><zeebe:script expression="=get value(camunda.vars.env.CB_SYSTEMS.services, service)" resultVariable="serviceInfo" /></bpmn:extensionElements><bpmn:incoming>Flow_AlertReceived_LookUpService</bpmn:incoming><bpmn:outgoing>Flow_LookUpService_TriageAgent</bpmn:outgoing></bpmn:scriptTask>
<bpmn:adHocSubProcess id="TriageAgent" name="Incident triage agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,"><bpmn:documentation>Correlates health, changes, past incidents and runbooks. Recommends impact and urgency; the severity matrix decides.</bpmn:documentation><bpmn:extensionElements><zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" /><zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="3" /><zeebe:ioMapping><zeebe:input source="openai" target="provider.type" /><zeebe:input source="completions" target="provider.openai.api.type" /><zeebe:input source="custom" target="provider.openai.backend.type" /><zeebe:input source="=camunda.vars.env.CB_GENAI.endpoint" target="provider.openai.backend.custom.endpoint" /><zeebe:input source="apiKey" target="provider.openai.backend.custom.authentication.type" /><zeebe:input source="{{secrets.CB_LLM_API_KEY}}" target="provider.openai.backend.custom.authentication.apiKey" /><zeebe:input source="=if is defined(modelOverride) and modelOverride != null then modelOverride else camunda.vars.env.CB_GENAI.model" target="provider.openai.model.model" /><zeebe:input source="modelDefault" target="provider.openai.api.completions.effort" /><zeebe:input source="=4096" target="provider.openai.api.completions.maxCompletionTokens" /><zeebe:input source="PT90S" target="provider.openai.timeouts.timeout" /><zeebe:input source="=camunda.vars.env.CB_PROMPTS.incidentTriage.text" target="data.systemPrompt.prompt" /><zeebe:input source="=&quot;Triage alert &quot; + incidentId + &quot; on service &quot; + service + &quot; (&quot; + serviceInfo.name + &quot;, tier &quot; + string(serviceInfo.tier) + &quot;).&#10;Alert: &quot; + alert.title + &quot;. Source: &quot; + alert.source + &quot;.&quot;" target="data.userPrompt.prompt" /><zeebe:input source="=triageAgent.context" target="agentContext" /><zeebe:input source="in-process" target="data.memory.storage.type" /><zeebe:input source="=30" target="data.memory.contextWindowSize" /><zeebe:input source="=if is defined(maxModelCallsOverride) and maxModelCallsOverride != null then maxModelCallsOverride else 10" target="data.limits.maxModelCalls" /><zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" /><zeebe:input source="text" target="data.response.format.type" /><zeebe:input source="=true" target="data.response.format.parseJson" /><zeebe:input source="=false" target="data.response.includeAssistantMessage" /><zeebe:input source="=true" target="data.response.includeAgentContext" /><zeebe:input target="agent" /><zeebe:output source="=agent" target="triageAgent" /><zeebe:output source="=if agent.responseJson != null then agent.responseJson else if agent.responseText != null then from json(replace(replace(agent.responseText, &quot;^\s*```(json)?\s*&quot;, &quot;&quot;), &quot;\s*```\s*$&quot;, &quot;&quot;)) else null" target="triage" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="1" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" /><zeebe:header key="retryBackoff" value="PT10S" /><zeebe:header key="errorExpression" value="=if error != null and (error.code = &quot;MAXIMUM_NUMBER_OF_MODEL_CALLS_REACHED&quot; or error.code = &quot;FAILED_TO_PARSE_RESPONSE_CONTENT&quot; or error.code = &quot;MODEL_RESPONSE_GUARDRAIL_INTERVENED&quot; or error.code = &quot;MODEL_CONTEXT_WINDOW_EXCEEDED&quot;) then bpmnError(&quot;AGENT_OFF_RAIL&quot;, error.message, {agentErrorCode: error.code}) else null" /></zeebe:taskHeaders><zeebe:properties><zeebe:property name="io.camunda.agenticai.toolContainer" value="true" /></zeebe:properties><zeebe:agentDefinition agentType="aiAgentSubProcess" /></bpmn:extensionElements><bpmn:incoming>Flow_LookUpService_TriageAgent</bpmn:incoming><bpmn:outgoing>Flow_TriageAgent_SetSeverity</bpmn:outgoing>
<bpmn:scriptTask id="GetServiceHealth" name="Get service health"><bpmn:documentation>Returns live SLO metrics for the service: p95 latency, error rate, trend and consumers affected.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=get value(camunda.vars.env.CB_SYSTEMS.health, serviceId)" resultVariable="toolCallResult" /><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.serviceId, &quot;Service id, for example dispute-intake-api&quot;)" target="serviceId" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:scriptTask id="GetRecentChanges" name="Get recent changes"><bpmn:documentation>Returns changes deployed to the service recently, with change ids.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=get or else(get value(camunda.vars.env.CB_SYSTEMS.changes, serviceId), [])" resultVariable="toolCallResult" /><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.serviceId, &quot;Service id&quot;)" target="serviceId" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:scriptTask id="SearchSimilarIncidents" name="Search similar incidents"><bpmn:documentation>Returns past incidents on the service with their resolution.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=get or else(get value(camunda.vars.env.CB_SYSTEMS.incidentHistory, serviceId), [])" resultVariable="toolCallResult" /><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.serviceId, &quot;Service id&quot;)" target="serviceId" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:scriptTask id="GetRunbook" name="Get runbook"><bpmn:documentation>Returns the runbook for the service.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=get value(camunda.vars.env.CB_SYSTEMS.runbooks, serviceId)" resultVariable="toolCallResult" /><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.serviceId, &quot;Service id&quot;)" target="serviceId" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:userTask id="AskOnCall" name="Ask the on-call engineer"><bpmn:documentation>Sends one question to the on-call engineer for the service and waits for the answer. Use only when the data contradict each other.</bpmn:documentation><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="CB_OnCallQuestionForm" /><zeebe:assignmentDefinition candidateGroups="=[serviceInfo.resolverGroup]" /><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.question, &quot;One specific question for the on-call engineer&quot;)" target="agentQuestion" /><zeebe:output source="={question: agentQuestion, answer: onCallAnswer}" target="toolCallResult" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:userTask>
</bpmn:adHocSubProcess>
<bpmn:boundaryEvent id="TriageOffRail" name="Agent off rail" attachedToRef="TriageAgent"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=agentErrorCode" target="agentErrorCode" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:outgoing>Flow_TriageOffRail_ManualTriage</bpmn:outgoing><bpmn:errorEventDefinition id="TriageOffRail_def" errorRef="Err_TriageOffRail" /></bpmn:boundaryEvent>
<bpmn:scriptTask id="ManualTriage" name="Assume high impact (no AI triage)"><bpmn:extensionElements><zeebe:script expression="={impact: &quot;HIGH&quot;, urgency: &quot;HIGH&quot;, suspectedCause: &quot;Unknown: triage agent stopped&quot;, linkedChange: &quot;none&quot;, similarIncident: &quot;none&quot;, firstActions: [&quot;Triage manually&quot;], summary: &quot;The triage agent stopped; treated as high impact until a person triages.&quot;, confidence: 0}" resultVariable="triage" /></bpmn:extensionElements><bpmn:incoming>Flow_TriageOffRail_ManualTriage</bpmn:incoming><bpmn:outgoing>Flow_ManualTriage_SetSeverity</bpmn:outgoing></bpmn:scriptTask>
<bpmn:businessRuleTask id="SetSeverity" name="Set severity and SLAs"><bpmn:documentation>Severity matrix owned by Global Operations: priority, acknowledge and resolve SLAs, escalation chain.</bpmn:documentation><bpmn:extensionElements><zeebe:calledDecision decisionId="CB_IncidentSeverity" resultVariable="severity" /><zeebe:ioMapping><zeebe:input source="=get or else(triage.impact, &quot;HIGH&quot;)" target="impact" /><zeebe:input source="=get or else(triage.urgency, &quot;HIGH&quot;)" target="urgency" /><zeebe:input source="=serviceInfo.customerFacing" target="customerFacing" /><zeebe:input source="=serviceInfo.regulatoryService" target="regulatoryService" /><zeebe:output source="=severity" target="severity" /><zeebe:output source="=severity.priority" target="obsPriority" /><zeebe:output source="=severity.ruleId" target="obsSeverityRule" /><zeebe:output source="=if is defined(triageAgent) and triageAgent != null then get or else(triageAgent.context.metrics.modelCalls, 0) else 0" target="obsModelCalls" /><zeebe:output source="=if is defined(triageAgent) and triageAgent != null then get or else(triageAgent.context.metrics.tokenUsage.inputTokenCount, 0) + get or else(triageAgent.context.metrics.tokenUsage.outputTokenCount, 0) else 0" target="obsTokens" /><zeebe:output source="=0" target="escalationLevel" /><zeebe:output source="=camunda.vars.env.CB_PROMPTS.incidentTriage.version" target="obsPromptVersion" /><zeebe:output source="=camunda.vars.env.CB_GENAI.model" target="obsModel" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_TriageAgent_SetSeverity</bpmn:incoming><bpmn:incoming>Flow_ManualTriage_SetSeverity</bpmn:incoming><bpmn:outgoing>Flow_SetSeverity_DisputeImpactGw</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="DisputeImpactGw" name="Statutory clocks at risk?" default="Flow_NoDisputeImpact"><bpmn:incoming>Flow_SetSeverity_DisputeImpactGw</bpmn:incoming><bpmn:outgoing>Flow_DisputeImpactGw_FlagDisputes</bpmn:outgoing><bpmn:outgoing>Flow_NoDisputeImpact</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="FlagDisputes" name="Flag open disputes at risk"><bpmn:extensionElements><zeebe:taskDefinition type="cb.disputes.flag" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_DisputeImpactGw_FlagDisputes</bpmn:incoming><bpmn:outgoing>Flow_FlagDisputes_ImpactMerge</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="ImpactMerge" name=""><bpmn:incoming>Flow_NoDisputeImpact</bpmn:incoming><bpmn:incoming>Flow_FlagDisputes_ImpactMerge</bpmn:incoming><bpmn:outgoing>Flow_ImpactMerge_NotifyResponders</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="NotifyResponders" name="Page responders, open bridge"><bpmn:extensionElements><zeebe:taskDefinition type="cb.notify" retries="3" /><zeebe:ioMapping><zeebe:input source="=&quot;INCIDENT_PAGE&quot;" target="notificationType" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_ImpactMerge_NotifyResponders</bpmn:incoming><bpmn:outgoing>Flow_NotifyResponders_Acknowledge</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Acknowledge" name="Acknowledge and take ownership"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="CB_IncidentAckForm" /><zeebe:assignmentDefinition candidateGroups="=[serviceInfo.resolverGroup]" /><zeebe:priorityDefinition priority="=if severity.priority = &quot;P1&quot; then 100 else if severity.priority = &quot;P2&quot; then 80 else 50" /><zeebe:taskSchedule dueDate="=replace(string(now() + duration(&quot;PT&quot; + string(max(5, floor(severity.ackMinutes * (if is defined(clockSecondsPerMinute) and clockSecondsPerMinute != null then clockSecondsPerMinute else camunda.vars.env.CB_CLOCK.secondsPerMinute)))) + &quot;S&quot;)), &quot;@.*$&quot;, &quot;Z&quot;)" /><zeebe:ioMapping><zeebe:input source="=get or else(triage.summary, &quot;&quot;)" target="triageSummary" /><zeebe:input source="=string join(get or else(triage.firstActions, []), &quot;&#10;&quot;)" target="firstActionsText" /><zeebe:input source="=severity.priority" target="priorityShown" /><zeebe:output source="=get or else(ackNote, &quot;&quot;)" target="ackNote" /><zeebe:output source="=now()" target="acknowledgedAt" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_NotifyResponders_Acknowledge</bpmn:incoming><bpmn:outgoing>Flow_Acknowledge_Resolve</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="AckSlaMissed" name="Acknowledge SLA missed" cancelActivity="false" attachedToRef="Acknowledge"><bpmn:outgoing>Flow_AckSlaMissed_EscalateIncident</bpmn:outgoing><bpmn:timerEventDefinition id="AckSlaMissed_def"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">="R3/" + "PT" + string(max(5, floor(severity.ackMinutes * (if is defined(clockSecondsPerMinute) and clockSecondsPerMinute != null then clockSecondsPerMinute else camunda.vars.env.CB_CLOCK.secondsPerMinute)))) + "S"</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="EscalateIncident" name="Escalate to next level"><bpmn:extensionElements><zeebe:taskDefinition type="cb.incident.escalate" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_AckSlaMissed_EscalateIncident</bpmn:incoming><bpmn:outgoing>Flow_EscalateIncident_Escalated</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="Escalated" name="Escalated"><bpmn:incoming>Flow_EscalateIncident_Escalated</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="Resolve" name="Resolve and confirm triage"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="CB_IncidentResolveForm" /><zeebe:assignmentDefinition candidateGroups="=[serviceInfo.resolverGroup]" /><zeebe:ioMapping><zeebe:input source="=get or else(triage.suspectedCause, &quot;&quot;)" target="suspectedCause" /><zeebe:input source="=get or else(triage.linkedChange, &quot;none&quot;)" target="linkedChange" /><zeebe:output source="={resolution: resolution, rootCause: rootCause, triageAccurate: triageAccurate}" target="resolutionRecord" /><zeebe:output source="=triageAccurate" target="obsTriageAccurate" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Acknowledge_Resolve</bpmn:incoming><bpmn:outgoing>Flow_Resolve_RecordIncidentAchievement</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="RecordIncidentAchievement" name="Record achievement for the responder"><bpmn:extensionElements><zeebe:taskDefinition type="cb.achievement.publish" retries="3" /><zeebe:ioMapping><zeebe:input source="=&quot;INCIDENT_RESOLVED&quot;" target="eventType" /><zeebe:input source="=get or else(resolverName, &quot;On-call engineer&quot;)" target="employee" /><zeebe:input source="=true" target="withinSla" /><zeebe:input source="=incidentId" target="sourceRef" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Resolve_RecordIncidentAchievement</bpmn:incoming><bpmn:outgoing>Flow_RecordIncidentAchievement_IncidentClosed</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="IncidentClosed" name="Incident closed"><bpmn:incoming>Flow_RecordIncidentAchievement_IncidentClosed</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_AlertReceived_LookUpService" sourceRef="AlertReceived" targetRef="LookUpService"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_LookUpService_TriageAgent" sourceRef="LookUpService" targetRef="TriageAgent"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_TriageAgent_SetSeverity" sourceRef="TriageAgent" targetRef="SetSeverity"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_TriageOffRail_ManualTriage" sourceRef="TriageOffRail" targetRef="ManualTriage"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ManualTriage_SetSeverity" sourceRef="ManualTriage" targetRef="SetSeverity"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_SetSeverity_DisputeImpactGw" sourceRef="SetSeverity" targetRef="DisputeImpactGw"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_DisputeImpactGw_FlagDisputes" name="Yes" sourceRef="DisputeImpactGw" targetRef="FlagDisputes"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=serviceInfo.regulatoryService and serviceInfo.customerFacing and (severity.priority = "P1" or severity.priority = "P2")</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_NoDisputeImpact" name="No" sourceRef="DisputeImpactGw" targetRef="ImpactMerge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_FlagDisputes_ImpactMerge" sourceRef="FlagDisputes" targetRef="ImpactMerge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ImpactMerge_NotifyResponders" sourceRef="ImpactMerge" targetRef="NotifyResponders"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_NotifyResponders_Acknowledge" sourceRef="NotifyResponders" targetRef="Acknowledge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_AckSlaMissed_EscalateIncident" sourceRef="AckSlaMissed" targetRef="EscalateIncident"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_EscalateIncident_Escalated" sourceRef="EscalateIncident" targetRef="Escalated"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Acknowledge_Resolve" sourceRef="Acknowledge" targetRef="Resolve"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Resolve_RecordIncidentAchievement" sourceRef="Resolve" targetRef="RecordIncidentAchievement"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_RecordIncidentAchievement_IncidentClosed" sourceRef="RecordIncidentAchievement" targetRef="IncidentClosed"></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_CB_IncidentManagement"><bpmndi:BPMNPlane id="Plane_CB_IncidentManagement" bpmnElement="CB_IncidentManagement">
<bpmndi:BPMNShape id="AlertReceived_di" bpmnElement="AlertReceived"><dc:Bounds x="72" y="312" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="35" y="352" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="LookUpService_di" bpmnElement="LookUpService"><dc:Bounds x="165" y="290" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="TriageAgent_di" bpmnElement="TriageAgent" isExpanded="true"><dc:Bounds x="300" y="130" width="520" height="400" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="GetServiceHealth_di" bpmnElement="GetServiceHealth"><dc:Bounds x="325" y="180" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="GetRecentChanges_di" bpmnElement="GetRecentChanges"><dc:Bounds x="455" y="180" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="SearchSimilarIncidents_di" bpmnElement="SearchSimilarIncidents"><dc:Bounds x="585" y="180" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="GetRunbook_di" bpmnElement="GetRunbook"><dc:Bounds x="325" y="320" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="AskOnCall_di" bpmnElement="AskOnCall"><dc:Bounds x="455" y="320" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="TriageOffRail_di" bpmnElement="TriageOffRail"><dc:Bounds x="752" y="512" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="715" y="552" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ManualTriage_di" bpmnElement="ManualTriage"><dc:Bounds x="715" y="570" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="SetSeverity_di" bpmnElement="SetSeverity"><dc:Bounds x="845" y="290" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="DisputeImpactGw_di" bpmnElement="DisputeImpactGw"><dc:Bounds x="995" y="305" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="965" y="271" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="FlagDisputes_di" bpmnElement="FlagDisputes"><dc:Bounds x="1075" y="150" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ImpactMerge_di" bpmnElement="ImpactMerge"><dc:Bounds x="1215" y="305" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="NotifyResponders_di" bpmnElement="NotifyResponders"><dc:Bounds x="1295" y="290" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Acknowledge_di" bpmnElement="Acknowledge"><dc:Bounds x="1435" y="290" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="AckSlaMissed_di" bpmnElement="AckSlaMissed"><dc:Bounds x="1502" y="352" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1465" y="392" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="EscalateIncident_di" bpmnElement="EscalateIncident"><dc:Bounds x="1575" y="430" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Escalated_di" bpmnElement="Escalated"><dc:Bounds x="1742" y="452" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1705" y="492" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
