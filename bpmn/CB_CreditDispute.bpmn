<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_CB_CreditDispute" targetNamespace="http://camunda.org/schema/1.0/bpmn" exporter="cb-camunda-demo build.py" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
<bpmn:message id="Msg_FurnisherResponse" name="cb-furnisher-response"><bpmn:extensionElements><zeebe:subscription correlationKey="=disputeId" /></bpmn:extensionElements></bpmn:message>
<bpmn:message id="Msg_Withdrawn" name="cb-dispute-withdrawn"><bpmn:extensionElements><zeebe:subscription correlationKey="=disputeId" /></bpmn:extensionElements></bpmn:message>
<bpmn:message id="Msg_ServiceIncident" name="cb-dispute-service-incident"><bpmn:extensionElements><zeebe:subscription correlationKey="=disputeId" /></bpmn:extensionElements></bpmn:message>
<bpmn:error id="Err_AgentOffRail" name="Agent off the rails" errorCode="AGENT_OFF_RAIL" />
<bpmn:error id="Err_Holidays" name="Holiday calendar unavailable" errorCode="HOLIDAYS_UNAVAILABLE" />
<bpmn:process id="CB_CreditDispute" name="Consumer credit dispute" isExecutable="true"><bpmn:documentation>A consumer disputes an item on their credit file. The statutory clock comes from a decision table per jurisdiction. An AI agent investigates and recommends; an approval authority table decides who signs off; analysts approve or override.</bpmn:documentation>
<bpmn:startEvent id="DisputeReceived" name="Dispute received"><bpmn:outgoing>Flow_DisputeReceived_VerifyIdentity</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="VerifyIdentity" name="Verify consumer identity"><bpmn:extensionElements><zeebe:taskDefinition type="cb.identity.verify" retries="3" /><zeebe:ioMapping><zeebe:output source="=identity" target="identity" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_DisputeReceived_VerifyIdentity</bpmn:incoming><bpmn:outgoing>Flow_VerifyIdentity_FetchHolidays</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="FetchHolidays" name="Fetch public holidays (REST)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12"><bpmn:documentation>Calls the public Nager.Date API for the jurisdiction's public holidays, so business-day clocks are correct.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="2" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="=&quot;https://date.nager.at/api/v3/PublicHolidays/&quot; + string(today().year) + &quot;/&quot; + (if jurisdiction = &quot;UK&quot; then &quot;GB&quot; else jurisdiction)" target="url" /><zeebe:input source="=10" target="connectionTimeoutInSeconds" /><zeebe:input source="=10" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={holidays: if is defined(response.body) and response.body != null then for h in response.body return h.date else []}" /><zeebe:header key="retryBackoff" value="PT2S" /><zeebe:header key="errorExpression" value="=if error != null then bpmnError(&quot;HOLIDAYS_UNAVAILABLE&quot;, error.message, {holidayError: error.message, holidayErrorCode: error.code}) else null" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_VerifyIdentity_FetchHolidays</bpmn:incoming><bpmn:outgoing>Flow_FetchHolidays_ClockMerge</bpmn:outgoing></bpmn:serviceTask>
<bpmn:boundaryEvent id="HolidaysDown" name="Calendar unavailable" attachedToRef="FetchHolidays"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=holidayError" target="holidayError" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:outgoing>Flow_HolidaysDown_WeekendsOnly</bpmn:outgoing><bpmn:errorEventDefinition id="HolidaysDown_def" errorRef="Err_Holidays" /></bpmn:boundaryEvent>
<bpmn:scriptTask id="WeekendsOnly" name="Count weekends only"><bpmn:extensionElements><zeebe:script expression="=[]" resultVariable="holidays" /></bpmn:extensionElements><bpmn:incoming>Flow_HolidaysDown_WeekendsOnly</bpmn:incoming><bpmn:outgoing>Flow_WeekendsOnly_ClockMerge</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="ClockMerge" name=""><bpmn:incoming>Flow_FetchHolidays_ClockMerge</bpmn:incoming><bpmn:incoming>Flow_WeekendsOnly_ClockMerge</bpmn:incoming><bpmn:outgoing>Flow_ClockMerge_SetClockPolicy</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="SetClockPolicy" name="Set statutory clock policy"><bpmn:documentation>Decision table owned by Consumer Relations Compliance: clock length, business or calendar days, furnisher window, regulation.</bpmn:documentation><bpmn:extensionElements><zeebe:calledDecision decisionId="CB_DisputeSlaPolicy" resultVariable="clockPolicy" /></bpmn:extensionElements><bpmn:incoming>Flow_ClockMerge_SetClockPolicy</bpmn:incoming><bpmn:outgoing>Flow_SetClockPolicy_StartClock</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:scriptTask id="StartClock" name="Start statutory clock"><bpmn:extensionElements><zeebe:script expression="={slaDays: clockPolicy.slaDays, businessDays: clockPolicy.businessDays, regulation: clockPolicy.regulation, receivedOn: string(today()), dueDate: string(if clockPolicy.businessDays then ((for i in 1..(clockPolicy.slaDays * 2 + 25) return today() + duration(&quot;P&quot; + string(i) + &quot;D&quot;))[not(list contains([&quot;Saturday&quot;,&quot;Sunday&quot;], day of week(item))) and not(list contains(holidays, string(item)))])[clockPolicy.slaDays] else today() + duration(&quot;P&quot; + string(clockPolicy.slaDays) + &quot;D&quot;)), holidaysConsidered: count(holidays), warnAfter: &quot;PT&quot; + string(max(5, floor(clockPolicy.slaDays * 0.75 * (if is defined(clockSecondsPerDay) and clockSecondsPerDay != null then clockSecondsPerDay else camunda.vars.env.CB_CLOCK.secondsPerDay)))) + &quot;S&quot;, breachAfter: &quot;PT&quot; + string(max(5, floor(clockPolicy.slaDays * (if is defined(clockSecondsPerDay) and clockSecondsPerDay != null then clockSecondsPerDay else camunda.vars.env.CB_CLOCK.secondsPerDay)))) + &quot;S&quot;, furnisherWindow: &quot;PT&quot; + string(max(5, floor(clockPolicy.furnisherWindowDays * (if is defined(clockSecondsPerDay) and clockSecondsPerDay != null then clockSecondsPerDay else camunda.vars.env.CB_CLOCK.secondsPerDay)))) + &quot;S&quot;}" resultVariable="clock" /><zeebe:ioMapping><zeebe:output source="=clock" target="clock" /><zeebe:output source="=&quot;ON_TRACK&quot;" target="slaStatus" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_SetClockPolicy_StartClock</bpmn:incoming><bpmn:outgoing>Flow_StartClock_Reinvestigation</bpmn:outgoing></bpmn:scriptTask>
<bpmn:subProcess id="Reinvestigation" name="Statutory reinvestigation"><bpmn:documentation>Everything inside runs against the statutory clock. Boundary timers warn at 75% and escalate at the deadline.</bpmn:documentation><bpmn:incoming>Flow_StartClock_Reinvestigation</bpmn:incoming><bpmn:outgoing>Flow_Reinvestigation_RecordAchievement</bpmn:outgoing>
<bpmn:startEvent id="ReinvestigationStarted" name=""><bpmn:outgoing>Flow_ReinvestigationStarted_NotifyFurnisher</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="NotifyFurnisher" name="Send dispute to furnisher"><bpmn:extensionElements><zeebe:taskDefinition type="cb.furnisher.send" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_ReinvestigationStarted_NotifyFurnisher</bpmn:incoming><bpmn:outgoing>Flow_NotifyFurnisher_AwaitFurnisher</bpmn:outgoing></bpmn:serviceTask>
<bpmn:eventBasedGateway id="AwaitFurnisher" name=""><bpmn:incoming>Flow_NotifyFurnisher_AwaitFurnisher</bpmn:incoming><bpmn:outgoing>Flow_AwaitFurnisher_FurnisherResponded</bpmn:outgoing><bpmn:outgoing>Flow_AwaitFurnisher_FurnisherWindowElapsed</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="FurnisherResponded" name="Furnisher responded"><bpmn:incoming>Flow_AwaitFurnisher_FurnisherResponded</bpmn:incoming><bpmn:outgoing>Flow_FurnisherResponded_DisputeInvestigator</bpmn:outgoing><bpmn:messageEventDefinition id="FurnisherResponded_def" messageRef="Msg_FurnisherResponse" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="FurnisherWindowElapsed" name="Furnisher window elapsed"><bpmn:incoming>Flow_AwaitFurnisher_FurnisherWindowElapsed</bpmn:incoming><bpmn:outgoing>Flow_FurnisherWindowElapsed_MarkUnverified</bpmn:outgoing><bpmn:timerEventDefinition id="FurnisherWindowElapsed_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=clock.furnisherWindow</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:adHocSubProcess id="DisputeInvestigator" name="Dispute investigator agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,"><bpmn:documentation>Investigates and recommends. It cannot decide: the approval authority table after it decides who signs off.</bpmn:documentation><bpmn:extensionElements><zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" /><zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="3" /><zeebe:ioMapping><zeebe:input source="openai" target="provider.type" /><zeebe:input source="completions" target="provider.openai.api.type" /><zeebe:input source="custom" target="provider.openai.backend.type" /><zeebe:input source="=camunda.vars.env.CB_GENAI.endpoint" target="provider.openai.backend.custom.endpoint" /><zeebe:input source="apiKey" target="provider.openai.backend.custom.authentication.type" /><zeebe:input source="{{secrets.OPENROUTER_API_KEY}}" target="provider.openai.backend.custom.authentication.apiKey" /><zeebe:input source="=if is defined(modelOverride) and modelOverride != null then modelOverride else camunda.vars.env.CB_GENAI.model" target="provider.openai.model.model" /><zeebe:input source="modelDefault" target="provider.openai.api.completions.effort" /><zeebe:input source="=4096" target="provider.openai.api.completions.maxCompletionTokens" /><zeebe:input source="PT90S" target="provider.openai.timeouts.timeout" /><zeebe:input source="=camunda.vars.env.CB_PROMPTS.disputeInvestigator.text" target="data.systemPrompt.prompt" /><zeebe:input source="=&quot;Investigate dispute &quot; + disputeId + &quot; for &quot; + consumerName + &quot; (&quot; + jurisdiction + &quot;).&#10;Dispute type: &quot; + disputeType + &quot;. Furnisher: &quot; + furnisher + &quot;, account &quot; + accountRef + &quot;.&#10;Received via: &quot; + channel + &quot;.&#10;Consumer statement: &quot; + consumerStatement" target="data.userPrompt.prompt" /><zeebe:input source="=investigator.context" target="agentContext" /><zeebe:input source="in-process" target="data.memory.storage.type" /><zeebe:input source="=30" target="data.memory.contextWindowSize" /><zeebe:input source="=if is defined(maxModelCallsOverride) and maxModelCallsOverride != null then maxModelCallsOverride else 12" target="data.limits.maxModelCalls" /><zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" /><zeebe:input source="text" target="data.response.format.type" /><zeebe:input source="=true" target="data.response.format.parseJson" /><zeebe:input source="=false" target="data.response.includeAssistantMessage" /><zeebe:input source="=true" target="data.response.includeAgentContext" /><zeebe:input target="agent" /><zeebe:output source="=agent" target="investigator" /><zeebe:output source="=if agent.responseJson != null then agent.responseJson else if agent.responseText != null then from json(replace(replace(agent.responseText, &quot;^\s*```(json)?\s*&quot;, &quot;&quot;), &quot;\s*```\s*$&quot;, &quot;&quot;)) else null" target="assessment" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="1" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" /><zeebe:header key="retryBackoff" value="PT10S" /><zeebe:header key="errorExpression" value="=if error != null and (error.code = &quot;MAXIMUM_NUMBER_OF_MODEL_CALLS_REACHED&quot; or error.code = &quot;FAILED_TO_PARSE_RESPONSE_CONTENT&quot; or error.code = &quot;MODEL_RESPONSE_GUARDRAIL_INTERVENED&quot; or error.code = &quot;MODEL_CONTEXT_WINDOW_EXCEEDED&quot;) then bpmnError(&quot;AGENT_OFF_RAIL&quot;, error.message, {agentErrorCode: error.code}) else null" /></zeebe:taskHeaders><zeebe:properties><zeebe:property name="io.camunda.agenticai.toolContainer" value="true" /></zeebe:properties><zeebe:agentDefinition agentType="aiAgentSubProcess" /></bpmn:extensionElements><bpmn:incoming>Flow_FurnisherResponded_DisputeInvestigator</bpmn:incoming><bpmn:outgoing>Flow_DisputeInvestigator_DetermineAuthority</bpmn:outgoing>
<bpmn:scriptTask id="GetTradeline" name="Get credit file tradeline"><bpmn:documentation>Returns the disputed tradeline from the credit file: furnisher, account, reported status, balance, dates and 24-month payment history.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=get or else(get value(camunda.vars.env.CB_SYSTEMS.creditFile, caseRef), {error: &quot;No tradeline found&quot;})" resultVariable="toolCallResult" /></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:scriptTask id="GetFurnisherResponse" name="Get furnisher response"><bpmn:documentation>Returns the furnisher's response to the dispute (ACDV): position AGREES_WITH_CONSUMER or VERIFIED, response code and detail.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=furnisherResponse" resultVariable="toolCallResult" /></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:scriptTask id="GetConsumerEvidence" name="Get consumer evidence"><bpmn:documentation>Returns the documents the consumer supplied, with fields extracted by document processing, and documentStatus DOCUMENTED, PARTIAL or NONE.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=get or else(get value(camunda.vars.env.CB_SYSTEMS.consumerEvidence, caseRef), {documentStatus: &quot;NONE&quot;, documents: []})" resultVariable="toolCallResult" /></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:scriptTask id="CheckDisputeHistory" name="Check dispute history"><bpmn:documentation>Returns the consumer's disputes in the last 12 months and their outcomes.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=get or else(get value(camunda.vars.env.CB_SYSTEMS.disputeHistory, consumerId), {disputes12m: 0, items: []})" resultVariable="toolCallResult" /></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:scriptTask id="CheckFraudSignals" name="Check identity and fraud signals"><bpmn:documentation>Returns identity verification status and fraud signals for the consumer from the identity resolution service.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=get or else(get value(camunda.vars.env.CB_SYSTEMS.fraudSignals, consumerId), {signals: [], identityVerified: false})" resultVariable="toolCallResult" /></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:scriptTask id="LookUpDisputePolicy" name="Look up dispute policy"><bpmn:documentation>Returns the regulation and the policy text that governs disputes in a jurisdiction (US, ZA, IN or UK). Quote it.</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=get or else(get value(camunda.vars.env.CB_SYSTEMS.policies, jurisdictionCode), {error: &quot;Unknown jurisdiction&quot;})" resultVariable="toolCallResult" /><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.jurisdiction, &quot;Jurisdiction code: US, ZA, IN or UK&quot;)" target="jurisdictionCode" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:scriptTask>
<bpmn:businessRuleTask id="ScoreEvidence" name="Score evidence (DMN)"><bpmn:documentation>Applies the evidence strength table owned by Consumer Relations Quality. Its score is binding: return it unchanged as confidence.</bpmn:documentation><bpmn:extensionElements><zeebe:calledDecision decisionId="CB_EvidenceStrength" resultVariable="toolCallResult" /><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.furnisherPosition, &quot;Furnisher position from the furnisher response: AGREES_WITH_CONSUMER, VERIFIED or NO_RESPONSE&quot;)" target="furnisherPosition" /><zeebe:input source="=fromAi(toolCall.consumerEvidence, &quot;documentStatus from the consumer evidence: DOCUMENTED, PARTIAL or NONE&quot;)" target="consumerEvidence" /><zeebe:input source="=fromAi(toolCall.fraudSignalCount, &quot;Number of fraud signals returned by the fraud check&quot;, &quot;number&quot;)" target="fraudSignalCount" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:businessRuleTask>
<bpmn:userTask id="AskSpecialist" name="Ask a dispute specialist"><bpmn:documentation>Sends one specific question to a dispute specialist and waits for the answer. Use only when the furnisher and the consumer evidence contradict each other.</bpmn:documentation><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="CB_SpecialistQuestionForm" /><zeebe:assignmentDefinition candidateGroups="dispute-specialists" /><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.question, &quot;One specific question for the specialist&quot;)" target="agentQuestion" /><zeebe:output source="={question: agentQuestion, answer: specialistAnswer, answeredBy: &quot;dispute specialist&quot;}" target="toolCallResult" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:userTask>
</bpmn:adHocSubProcess>
<bpmn:boundaryEvent id="InvestigatorOffRail" name="Agent off rail" attachedToRef="DisputeInvestigator"><bpmn:extensionElements><zeebe:ioMapping><zeebe:output source="=agentErrorCode" target="agentErrorCode" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:outgoing>Flow_InvestigatorOffRail_InvestigatorFallback</bpmn:outgoing><bpmn:errorEventDefinition id="InvestigatorOffRail_def" errorRef="Err_AgentOffRail" /></bpmn:boundaryEvent>
<bpmn:scriptTask id="InvestigatorFallback" name="Send to senior analyst (no AI recommendation)"><bpmn:extensionElements><zeebe:script expression="={recommendation: &quot;NEEDS_HUMAN&quot;, confidence: 0, furnisherAgrees: false, fraudIndicators: false, summary: &quot;The investigator agent stopped (&quot; + get or else(agentErrorCode, &quot;unknown&quot;) + &quot;). Review the case directly.&quot;, evidence: [], consumerLetter: &quot;&quot;}" resultVariable="assessment" /></bpmn:extensionElements><bpmn:incoming>Flow_InvestigatorOffRail_InvestigatorFallback</bpmn:incoming><bpmn:outgoing>Flow_InvestigatorFallback_DetermineAuthority</bpmn:outgoing></bpmn:scriptTask>
<bpmn:businessRuleTask id="DetermineAuthority" name="Determine approval authority"><bpmn:documentation>Approval authority table owned by Consumer Relations Quality. The agent never approves its own recommendation.</bpmn:documentation><bpmn:extensionElements><zeebe:calledDecision decisionId="CB_DisputeApprovalAuthority" resultVariable="authority" /><zeebe:ioMapping><zeebe:input source="=get or else(assessment.recommendation, &quot;NEEDS_HUMAN&quot;)" target="recommendation" /><zeebe:input source="=get or else(assessment.confidence, 0)" target="confidence" /><zeebe:input source="=get or else(assessment.fraudIndicators, false)" target="fraudIndicators" /><zeebe:input source="=get or else(assessment.furnisherAgrees, false)" target="furnisherAgrees" /><zeebe:output source="=authority" target="authority" /><zeebe:output source="=authority.route" target="obsRoute" /><zeebe:output source="=authority.ruleId" target="obsAuthorityRule" /><zeebe:output source="=get or else(assessment.recommendation, &quot;NEEDS_HUMAN&quot;)" target="obsRecommendation" /><zeebe:output source="=get or else(assessment.confidence, 0)" target="obsConfidence" /><zeebe:output source="=&quot;NOT_REQUIRED&quot;" target="obsAnalystDecision" /><zeebe:output source="=get or else(assessment.furnisherAgrees, false)" target="obsFurnisherAgrees" /><zeebe:output source="=get or else(assessment.fraudIndicators, false)" target="obsFraudIndicators" /><zeebe:output source="=if is defined(investigator) and investigator != null then get or else(investigator.context.metrics.modelCalls, 0) else 0" target="obsModelCalls" /><zeebe:output source="=if is defined(investigator) and investigator != null then get or else(investigator.context.metrics.tokenUsage.inputTokenCount, 0) + get or else(investigator.context.metrics.tokenUsage.outputTokenCount, 0) else 0" target="obsTokens" /><zeebe:output source="=camunda.vars.env.CB_PROMPTS.disputeInvestigator.version" target="obsPromptVersion" /><zeebe:output source="=camunda.vars.env.CB_GENAI.model" target="obsModel" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_DisputeInvestigator_DetermineAuthority</bpmn:incoming><bpmn:incoming>Flow_InvestigatorFallback_DetermineAuthority</bpmn:incoming><bpmn:outgoing>Flow_DetermineAuthority_RouteGateway</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="RouteGateway" name="Who signs off?" default="Flow_Route_Review"><bpmn:incoming>Flow_DetermineAuthority_RouteGateway</bpmn:incoming><bpmn:outgoing>Flow_RouteGateway_AutoApply</bpmn:outgoing><bpmn:outgoing>Flow_Route_Review</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="AutoApply" name="Accept recommendation (within authority)"><bpmn:extensionElements><zeebe:script expression="={outcome: assessment.recommendation, correction: assessment.correction, decidedBy: &quot;Rule &quot; + authority.ruleId, mode: &quot;AUTO&quot;, letter: assessment.consumerLetter}" resultVariable="decision" /></bpmn:extensionElements><bpmn:incoming>Flow_RouteGateway_AutoApply</bpmn:incoming><bpmn:outgoing>Flow_AutoApply_DecisionMerge</bpmn:outgoing></bpmn:scriptTask>
<bpmn:userTask id="ReviewRecommendation" name="Review AI recommendation"><bpmn:documentation>The analyst sees the recommendation, the evidence and the rule that sent the case to them, and approves or overrides.</bpmn:documentation><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="CB_DisputeReviewForm" /><zeebe:assignmentDefinition candidateGroups="=[authority.reviewGroup]" /><zeebe:priorityDefinition priority="=authority.priority" /><zeebe:taskSchedule dueDate="=replace(string(now() + duration(&quot;PT&quot; + string(max(5, floor(authority.reviewHours * (if is defined(clockSecondsPerHour) and clockSecondsPerHour != null then clockSecondsPerHour else camunda.vars.env.CB_CLOCK.secondsPerHour)))) + &quot;S&quot;)), &quot;@.*$&quot;, &quot;Z&quot;)" /><zeebe:ioMapping><zeebe:input source="=assessment.recommendation" target="aiRecommendation" /><zeebe:input source="=string(assessment.confidence)" target="aiConfidence" /><zeebe:input source="=get or else(assessment.correction, &quot;&quot;)" target="aiCorrection" /><zeebe:input source="=authority.ruleId + &quot;: &quot; + authority.reason" target="authorityReason" /><zeebe:input source="=get or else(assessment.summary, &quot;&quot;)" target="aiSummary" /><zeebe:input source="=string join(for e in get or else(assessment.evidence, []) return e.source + &quot;: &quot; + e.finding, &quot;&#10;&quot;)" target="evidenceText" /><zeebe:input source="=get or else(assessment.consumerLetter, &quot;&quot;)" target="consumerLetter" /><zeebe:output source="={outcome: if analystDecision = &quot;APPROVE&quot; then assessment.recommendation else overrideOutcome, correction: if analystDecision = &quot;APPROVE&quot; then assessment.correction else get or else(overrideReason, &quot;&quot;), decidedBy: get or else(reviewerName, &quot;Analyst&quot;), mode: if analystDecision = &quot;APPROVE&quot; then &quot;APPROVED&quot; else &quot;OVERRIDDEN&quot;, reason: get or else(overrideReason, null), letter: consumerLetter}" target="decision" /><zeebe:output source="=if analystDecision = &quot;APPROVE&quot; then &quot;APPROVED&quot; else &quot;OVERRIDDEN&quot;" target="obsAnalystDecision" /><zeebe:output source="=get or else(overrideReason, null)" target="obsOverrideReason" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Route_Review</bpmn:incoming><bpmn:outgoing>Flow_ReviewRecommendation_DecisionMerge</bpmn:outgoing></bpmn:userTask>
<bpmn:boundaryEvent id="ReviewSlaMissed" name="Review SLA missed" cancelActivity="false" attachedToRef="ReviewRecommendation"><bpmn:outgoing>Flow_ReviewSlaMissed_EscalateReview</bpmn:outgoing><bpmn:timerEventDefinition id="ReviewSlaMissed_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT" + string(max(5, floor(authority.reviewHours * (if is defined(clockSecondsPerHour) and clockSecondsPerHour != null then clockSecondsPerHour else camunda.vars.env.CB_CLOCK.secondsPerHour)))) + "S"</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="EscalateReview" name="Reassign to senior analysts, raise priority"><bpmn:extensionElements><zeebe:taskDefinition type="cb.review.escalate" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_ReviewSlaMissed_EscalateReview</bpmn:incoming><bpmn:outgoing>Flow_EscalateReview_ReviewEscalated</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="ReviewEscalated" name="Review escalated"><bpmn:incoming>Flow_EscalateReview_ReviewEscalated</bpmn:incoming></bpmn:endEvent>
<bpmn:scriptTask id="MarkUnverified" name="Delete unverified item (policy)"><bpmn:extensionElements><zeebe:script expression="={outcome: &quot;DELETE&quot;, correction: &quot;Delete the item: the furnisher did not verify it within the window&quot;, decidedBy: &quot;Policy &quot; + clock.regulation, mode: &quot;UNVERIFIED&quot;, letter: &quot;We could not verify the information you disputed, so we have removed it from your credit file.&quot;}" resultVariable="decision" /><zeebe:ioMapping><zeebe:output source="=decision" target="decision" /><zeebe:output source="=&quot;UNVERIFIED_DELETE&quot;" target="obsRoute" /><zeebe:output source="=&quot;NOT_REQUIRED&quot;" target="obsAnalystDecision" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_FurnisherWindowElapsed_MarkUnverified</bpmn:incoming><bpmn:outgoing>Flow_MarkUnverified_DecisionMerge</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="DecisionMerge" name=""><bpmn:incoming>Flow_MarkUnverified_DecisionMerge</bpmn:incoming><bpmn:incoming>Flow_AutoApply_DecisionMerge</bpmn:incoming><bpmn:incoming>Flow_ReviewRecommendation_DecisionMerge</bpmn:incoming><bpmn:outgoing>Flow_DecisionMerge_UpdateCreditFile</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="UpdateCreditFile" name="Update credit file"><bpmn:documentation>Writes the outcome to the credit file database. A locked record fails the job: the incident shows in Operate and is retried from there.</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="cb.creditfile.update" retries="1" /></bpmn:extensionElements><bpmn:incoming>Flow_DecisionMerge_UpdateCreditFile</bpmn:incoming><bpmn:outgoing>Flow_UpdateCreditFile_SendResults</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="SendResults" name="Send results to consumer and furnisher"><bpmn:extensionElements><zeebe:taskDefinition type="cb.notify" retries="3" /><zeebe:ioMapping><zeebe:input source="=&quot;DISPUTE_RESULT&quot;" target="notificationType" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_UpdateCreditFile_SendResults</bpmn:incoming><bpmn:outgoing>Flow_SendResults_ReinvestigationDone</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="ReinvestigationDone" name=""><bpmn:incoming>Flow_SendResults_ReinvestigationDone</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_ReinvestigationStarted_NotifyFurnisher" sourceRef="ReinvestigationStarted" targetRef="NotifyFurnisher"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_NotifyFurnisher_AwaitFurnisher" sourceRef="NotifyFurnisher" targetRef="AwaitFurnisher"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_AwaitFurnisher_FurnisherResponded" sourceRef="AwaitFurnisher" targetRef="FurnisherResponded"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_AwaitFurnisher_FurnisherWindowElapsed" sourceRef="AwaitFurnisher" targetRef="FurnisherWindowElapsed"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_FurnisherResponded_DisputeInvestigator" sourceRef="FurnisherResponded" targetRef="DisputeInvestigator"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_FurnisherWindowElapsed_MarkUnverified" sourceRef="FurnisherWindowElapsed" targetRef="MarkUnverified"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_MarkUnverified_DecisionMerge" sourceRef="MarkUnverified" targetRef="DecisionMerge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_DisputeInvestigator_DetermineAuthority" sourceRef="DisputeInvestigator" targetRef="DetermineAuthority"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_InvestigatorOffRail_InvestigatorFallback" sourceRef="InvestigatorOffRail" targetRef="InvestigatorFallback"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_InvestigatorFallback_DetermineAuthority" sourceRef="InvestigatorFallback" targetRef="DetermineAuthority"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_DetermineAuthority_RouteGateway" sourceRef="DetermineAuthority" targetRef="RouteGateway"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_RouteGateway_AutoApply" name="Within authority" sourceRef="RouteGateway" targetRef="AutoApply"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=authority.route = "AUTO_APPLY"</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Route_Review" name="Person signs off" sourceRef="RouteGateway" targetRef="ReviewRecommendation"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_AutoApply_DecisionMerge" sourceRef="AutoApply" targetRef="DecisionMerge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ReviewRecommendation_DecisionMerge" sourceRef="ReviewRecommendation" targetRef="DecisionMerge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ReviewSlaMissed_EscalateReview" sourceRef="ReviewSlaMissed" targetRef="EscalateReview"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_EscalateReview_ReviewEscalated" sourceRef="EscalateReview" targetRef="ReviewEscalated"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_DecisionMerge_UpdateCreditFile" sourceRef="DecisionMerge" targetRef="UpdateCreditFile"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_UpdateCreditFile_SendResults" sourceRef="UpdateCreditFile" targetRef="SendResults"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_SendResults_ReinvestigationDone" sourceRef="SendResults" targetRef="ReinvestigationDone"></bpmn:sequenceFlow>
</bpmn:subProcess>
<bpmn:boundaryEvent id="ClockWarning" name="75% of statutory clock" cancelActivity="false" attachedToRef="Reinvestigation"><bpmn:outgoing>Flow_ClockWarning_AlertTeamLead</bpmn:outgoing><bpmn:timerEventDefinition id="ClockWarning_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=clock.warnAfter</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="AlertTeamLead" name="Alert team lead, raise case priority"><bpmn:extensionElements><zeebe:taskDefinition type="cb.sla.alert" retries="3" /><zeebe:ioMapping><zeebe:input source="=&quot;AT_RISK&quot;" target="newSlaStatus" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_ClockWarning_AlertTeamLead</bpmn:incoming><bpmn:outgoing>Flow_AlertTeamLead_TeamLeadAlerted</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="TeamLeadAlerted" name="Team lead alerted"><bpmn:incoming>Flow_AlertTeamLead_TeamLeadAlerted</bpmn:incoming></bpmn:endEvent>
<bpmn:boundaryEvent id="ClockBreached" name="Statutory deadline reached" cancelActivity="false" attachedToRef="Reinvestigation"><bpmn:outgoing>Flow_ClockBreached_MarkBreached</bpmn:outgoing><bpmn:timerEventDefinition id="ClockBreached_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=clock.breachAfter</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:serviceTask id="MarkBreached" name="Record deadline breach"><bpmn:extensionElements><zeebe:taskDefinition type="cb.sla.alert" retries="3" /><zeebe:ioMapping><zeebe:input source="=&quot;BREACHED&quot;" target="newSlaStatus" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_ClockBreached_MarkBreached</bpmn:incoming><bpmn:outgoing>Flow_MarkBreached_ComplianceBreachReview</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="ComplianceBreachReview" name="Compliance review of missed deadline"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="CB_StatutoryBreachForm" /><zeebe:assignmentDefinition candidateGroups="compliance-officers" /><zeebe:priorityDefinition priority="=100" /></bpmn:extensionElements><bpmn:incoming>Flow_MarkBreached_ComplianceBreachReview</bpmn:incoming><bpmn:outgoing>Flow_ComplianceBreachReview_BreachReviewed</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="BreachReviewed" name="Breach reviewed"><bpmn:incoming>Flow_ComplianceBreachReview_BreachReviewed</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_ClockWarning_AlertTeamLead" sourceRef="ClockWarning" targetRef="AlertTeamLead"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_AlertTeamLead_TeamLeadAlerted" sourceRef="AlertTeamLead" targetRef="TeamLeadAlerted"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ClockBreached_MarkBreached" sourceRef="ClockBreached" targetRef="MarkBreached"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_MarkBreached_ComplianceBreachReview" sourceRef="MarkBreached" targetRef="ComplianceBreachReview"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ComplianceBreachReview_BreachReviewed" sourceRef="ComplianceBreachReview" targetRef="BreachReviewed"></bpmn:sequenceFlow>
<bpmn:sendTask id="RecordAchievement" name="Record achievement for the analyst"><bpmn:extensionElements><zeebe:taskDefinition type="cb.achievement.publish" retries="3" /><zeebe:ioMapping><zeebe:input source="=&quot;DISPUTE_RESOLVED&quot;" target="eventType" /><zeebe:input source="=decision.decidedBy" target="employee" /><zeebe:input source="=slaStatus != &quot;BREACHED&quot;" target="withinSla" /><zeebe:input source="=disputeId" target="sourceRef" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Reinvestigation_RecordAchievement</bpmn:incoming><bpmn:outgoing>Flow_RecordAchievement_DisputeResolved</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="DisputeResolved" name="Dispute resolved"><bpmn:incoming>Flow_RecordAchievement_DisputeResolved</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_DisputeReceived_VerifyIdentity" sourceRef="DisputeReceived" targetRef="VerifyIdentity"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_VerifyIdentity_FetchHolidays" sourceRef="VerifyIdentity" targetRef="FetchHolidays"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_FetchHolidays_ClockMerge" sourceRef="FetchHolidays" targetRef="ClockMerge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_HolidaysDown_WeekendsOnly" sourceRef="HolidaysDown" targetRef="WeekendsOnly"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_WeekendsOnly_ClockMerge" sourceRef="WeekendsOnly" targetRef="ClockMerge"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_ClockMerge_SetClockPolicy" sourceRef="ClockMerge" targetRef="SetClockPolicy"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_SetClockPolicy_StartClock" sourceRef="SetClockPolicy" targetRef="StartClock"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_StartClock_Reinvestigation" sourceRef="StartClock" targetRef="Reinvestigation"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_Reinvestigation_RecordAchievement" sourceRef="Reinvestigation" targetRef="RecordAchievement"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_RecordAchievement_DisputeResolved" sourceRef="RecordAchievement" targetRef="DisputeResolved"></bpmn:sequenceFlow>
<bpmn:subProcess id="WithdrawnHandler" name="Consumer withdraws dispute" triggeredByEvent="true">
<bpmn:startEvent id="WithdrawnStart" name="Dispute withdrawn"><bpmn:outgoing>Flow_WithdrawnStart_CloseWithdrawn</bpmn:outgoing><bpmn:messageEventDefinition id="WithdrawnStart_def" messageRef="Msg_Withdrawn" /></bpmn:startEvent>
<bpmn:scriptTask id="CloseWithdrawn" name="Close case as withdrawn"><bpmn:extensionElements><zeebe:script expression="={outcome: &quot;WITHDRAWN&quot;, decidedBy: &quot;Consumer&quot;, mode: &quot;WITHDRAWN&quot;}" resultVariable="decision" /></bpmn:extensionElements><bpmn:incoming>Flow_WithdrawnStart_CloseWithdrawn</bpmn:incoming><bpmn:outgoing>Flow_CloseWithdrawn_ClosedWithdrawn</bpmn:outgoing></bpmn:scriptTask>
<bpmn:endEvent id="ClosedWithdrawn" name="Closed as withdrawn"><bpmn:incoming>Flow_CloseWithdrawn_ClosedWithdrawn</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_WithdrawnStart_CloseWithdrawn" sourceRef="WithdrawnStart" targetRef="CloseWithdrawn"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_CloseWithdrawn_ClosedWithdrawn" sourceRef="CloseWithdrawn" targetRef="ClosedWithdrawn"></bpmn:sequenceFlow>
</bpmn:subProcess>
<bpmn:subProcess id="ServiceIncidentHandler" name="Service incident affects this case" triggeredByEvent="true">
<bpmn:startEvent id="ServiceIncidentStart" name="Dispute service incident" isInterrupting="false"><bpmn:outgoing>Flow_ServiceIncidentStart_FlagClockAtRisk</bpmn:outgoing><bpmn:messageEventDefinition id="ServiceIncidentStart_def" messageRef="Msg_ServiceIncident" /></bpmn:startEvent>
<bpmn:scriptTask id="FlagClockAtRisk" name="Flag statutory clock at risk"><bpmn:extensionElements><zeebe:script expression="={incidentId: incidentRef, priority: incidentPriority, flaggedAt: string(now())}" resultVariable="serviceIncident" /></bpmn:extensionElements><bpmn:incoming>Flow_ServiceIncidentStart_FlagClockAtRisk</bpmn:incoming><bpmn:outgoing>Flow_FlagClockAtRisk_ClockFlagged</bpmn:outgoing></bpmn:scriptTask>
<bpmn:endEvent id="ClockFlagged" name="Clock flagged"><bpmn:incoming>Flow_FlagClockAtRisk_ClockFlagged</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_ServiceIncidentStart_FlagClockAtRisk" sourceRef="ServiceIncidentStart" targetRef="FlagClockAtRisk"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_FlagClockAtRisk_ClockFlagged" sourceRef="FlagClockAtRisk" targetRef="ClockFlagged"></bpmn:sequenceFlow>
</bpmn:subProcess>
</bpmn:process>
