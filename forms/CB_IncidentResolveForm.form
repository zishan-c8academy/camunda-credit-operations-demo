{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "cb-camunda-demo build.py",
    "version": "1"
  },
  "schemaVersion": 18,
  "id": "CB_IncidentResolveForm",
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## Resolve {{incidentId}}\nSuspected cause from triage: {{suspectedCause}} (change {{linkedChange}})",
      "id": "CB_IncidentResolveForm_f0"
    },
    {
      "type": "textarea",
      "key": "resolution",
      "label": "What fixed it",
      "validate": {
        "required": true
      },
      "id": "CB_IncidentResolveForm_f1"
    },
    {
      "type": "textfield",
      "key": "rootCause",
      "label": "Root cause",
      "id": "CB_IncidentResolveForm_f2"
    },
    {
      "type": "radio",
      "key": "triageAccurate",
      "label": "Was the AI triage right?",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Yes",
          "value": "YES"
        },
        {
          "label": "Partly",
          "value": "PARTLY"
        },
        {
          "label": "No",
          "value": "NO"
        }
      ],
      "id": "CB_IncidentResolveForm_f3"
    },
    {
      "type": "textfield",
      "key": "resolverName",
      "label": "Your name",
      "id": "CB_IncidentResolveForm_f4"
    }
  ]
}