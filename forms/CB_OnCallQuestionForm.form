{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "cb-camunda-demo build.py",
    "version": "1"
  },
  "schemaVersion": 18,
  "id": "CB_OnCallQuestionForm",
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "## The triage agent has a question\nIncident {{incidentId}} on {{service}}",
      "id": "CB_OnCallQuestionForm_f0"
    },
    {
      "type": "textarea",
      "key": "agentQuestion",
      "label": "Question",
      "readonly": true,
      "id": "CB_OnCallQuestionForm_f1"
    },
    {
      "type": "textarea",
      "key": "onCallAnswer",
      "label": "Your answer",
      "validate": {
        "required": true
      },
      "id": "CB_OnCallQuestionForm_f2"
    }
  ]
}