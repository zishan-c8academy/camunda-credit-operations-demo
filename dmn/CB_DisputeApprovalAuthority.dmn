<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_CB_DisputeApprovalAuthority" name="Dispute approval authority" namespace="http://camunda.org/schema/1.0/dmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <decision id="CB_DisputeApprovalAuthority" name="Dispute approval authority">
    <decisionTable id="DT_CB_DisputeApprovalAuthority" hitPolicy="FIRST">
      <input id="In_CB_DisputeApprovalAuthority_0" label="Recommendation"><inputExpression id="InExpr_CB_DisputeApprovalAuthority_0" typeRef="string"><text>recommendation</text></inputExpression></input><input id="In_CB_DisputeApprovalAuthority_1" label="Confidence"><inputExpression id="InExpr_CB_DisputeApprovalAuthority_1" typeRef="number"><text>confidence</text></inputExpression></input><input id="In_CB_DisputeApprovalAuthority_2" label="Fraud indicators"><inputExpression id="InExpr_CB_DisputeApprovalAuthority_2" typeRef="boolean"><text>fraudIndicators</text></inputExpression></input><input id="In_CB_DisputeApprovalAuthority_3" label="Furnisher agrees"><inputExpression id="InExpr_CB_DisputeApprovalAuthority_3" typeRef="boolean"><text>furnisherAgrees</text></inputExpression></input><input id="In_CB_DisputeApprovalAuthority_4" label="Vulnerable consumer"><inputExpression id="InExpr_CB_DisputeApprovalAuthority_4" typeRef="boolean"><text>vulnerableConsumer</text></inputExpression></input><input id="In_CB_DisputeApprovalAuthority_5" label="Dispute type"><inputExpression id="InExpr_CB_DisputeApprovalAuthority_5" typeRef="string"><text>disputeType</text></inputExpression></input>
      <output id="Out_CB_DisputeApprovalAuthority_0" label="Route" name="route" typeRef="string" /><output id="Out_CB_DisputeApprovalAuthority_1" label="Review group" name="reviewGroup" typeRef="string" /><output id="Out_CB_DisputeApprovalAuthority_2" label="Review SLA (hours)" name="reviewHours" typeRef="number" /><output id="Out_CB_DisputeApprovalAuthority_3" label="Priority" name="priority" typeRef="number" /><output id="Out_CB_DisputeApprovalAuthority_4" label="Rule" name="ruleId" typeRef="string" /><output id="Out_CB_DisputeApprovalAuthority_5" label="Reason" name="reason" typeRef="string" />
      <rule id="A-01"><description></description><inputEntry id="A-01_i0"><text>-</text></inputEntry><inputEntry id="A-01_i1"><text>-</text></inputEntry><inputEntry id="A-01_i2"><text>true</text></inputEntry><inputEntry id="A-01_i3"><text>-</text></inputEntry><inputEntry id="A-01_i4"><text>-</text></inputEntry><inputEntry id="A-01_i5"><text>-</text></inputEntry><outputEntry id="A-01_o0"><text>"REVIEW"</text></outputEntry><outputEntry id="A-01_o1"><text>"fraud-compliance"</text></outputEntry><outputEntry id="A-01_o2"><text>24</text></outputEntry><outputEntry id="A-01_o3"><text>85</text></outputEntry><outputEntry id="A-01_o4"><text>"A-01"</text></outputEntry><outputEntry id="A-01_o5"><text>"Possible identity fraud: fraud and compliance decide"</text></outputEntry></rule><rule id="A-02"><description></description><inputEntry id="A-02_i0"><text>-</text></inputEntry><inputEntry id="A-02_i1"><text>-</text></inputEntry><inputEntry id="A-02_i2"><text>-</text></inputEntry><inputEntry id="A-02_i3"><text>-</text></inputEntry><inputEntry id="A-02_i4"><text>true</text></inputEntry><inputEntry id="A-02_i5"><text>-</text></inputEntry><outputEntry id="A-02_o0"><text>"REVIEW"</text></outputEntry><outputEntry id="A-02_o1"><text>"senior-analysts"</text></outputEntry><outputEntry id="A-02_o2"><text>8</text></outputEntry><outputEntry id="A-02_o3"><text>75</text></outputEntry><outputEntry id="A-02_o4"><text>"A-02"</text></outputEntry><outputEntry id="A-02_o5"><text>"Vulnerable consumer: a senior analyst decides"</text></outputEntry></rule><rule id="A-03"><description></description><inputEntry id="A-03_i0"><text>"NEEDS_HUMAN"</text></inputEntry><inputEntry id="A-03_i1"><text>-</text></inputEntry><inputEntry id="A-03_i2"><text>-</text></inputEntry><inputEntry id="A-03_i3"><text>-</text></inputEntry><inputEntry id="A-03_i4"><text>-</text></inputEntry><inputEntry id="A-03_i5"><text>-</text></inputEntry><outputEntry id="A-03_o0"><text>"REVIEW"</text></outputEntry><outputEntry id="A-03_o1"><text>"senior-analysts"</text></outputEntry><outputEntry id="A-03_o2"><text>8</text></outputEntry><outputEntry id="A-03_o3"><text>70</text></outputEntry><outputEntry id="A-03_o4"><text>"A-03"</text></outputEntry><outputEntry id="A-03_o5"><text>"No usable AI recommendation"</text></outputEntry></rule><rule id="A-04"><description></description><inputEntry id="A-04_i0"><text>-</text></inputEntry><inputEntry id="A-04_i1"><text>&lt; 0.7</text></inputEntry><inputEntry id="A-04_i2"><text>-</text></inputEntry><inputEntry id="A-04_i3"><text>-</text></inputEntry><inputEntry id="A-04_i4"><text>-</text></inputEntry><inputEntry id="A-04_i5"><text>-</text></inputEntry><outputEntry id="A-04_o0"><text>"REVIEW"</text></outputEntry><outputEntry id="A-04_o1"><text>"senior-analysts"</text></outputEntry><outputEntry id="A-04_o2"><text>8</text></outputEntry><outputEntry id="A-04_o3"><text>65</text></outputEntry><outputEntry id="A-04_o4"><text>"A-04"</text></outputEntry><outputEntry id="A-04_o5"><text>"Evidence conflicts (score below 0.7)"</text></outputEntry></rule><rule id="A-05"><description></description><inputEntry id="A-05_i0"><text>"VERIFY_AS_REPORTED"</text></inputEntry><inputEntry id="A-05_i1"><text>-</text></inputEntry><inputEntry id="A-05_i2"><text>-</text></inputEntry><inputEntry id="A-05_i3"><text>-</text></inputEntry><inputEntry id="A-05_i4"><text>-</text></inputEntry><inputEntry id="A-05_i5"><text>-</text></inputEntry><outputEntry id="A-05_o0"><text>"REVIEW"</text></outputEntry><outputEntry id="A-05_o1"><text>"dispute-analysts"</text></outputEntry><outputEntry id="A-05_o2"><text>8</text></outputEntry><outputEntry id="A-05_o3"><text>55</text></outputEntry><outputEntry id="A-05_o4"><text>"A-05"</text></outputEntry><outputEntry id="A-05_o5"><text>"Outcome goes against the consumer: a person signs off"</text></outputEntry></rule><rule id="A-06"><description>Tunable: autoApplyMinConfidence</description><inputEntry id="A-06_i0"><text>"CORRECT","DELETE"</text></inputEntry><inputEntry id="A-06_i1"><text>&gt;= 0.9</text></inputEntry><inputEntry id="A-06_i2"><text>false</text></inputEntry><inputEntry id="A-06_i3"><text>true</text></inputEntry><inputEntry id="A-06_i4"><text>false</text></inputEntry><inputEntry id="A-06_i5"><text>-</text></inputEntry><outputEntry id="A-06_o0"><text>"AUTO_APPLY"</text></outputEntry><outputEntry id="A-06_o1"><text>"none"</text></outputEntry><outputEntry id="A-06_o2"><text>0</text></outputEntry><outputEntry id="A-06_o3"><text>0</text></outputEntry><outputEntry id="A-06_o4"><text>"A-06"</text></outputEntry><outputEntry id="A-06_o5"><text>"Furnisher agrees and evidence score at least 0.9: within authority"</text></outputEntry></rule><rule id="A-07"><description></description><inputEntry id="A-07_i0"><text>-</text></inputEntry><inputEntry id="A-07_i1"><text>-</text></inputEntry><inputEntry id="A-07_i2"><text>-</text></inputEntry><inputEntry id="A-07_i3"><text>-</text></inputEntry><inputEntry id="A-07_i4"><text>-</text></inputEntry><inputEntry id="A-07_i5"><text>-</text></inputEntry><outputEntry id="A-07_o0"><text>"REVIEW"</text></outputEntry><outputEntry id="A-07_o1"><text>"dispute-analysts"</text></outputEntry><outputEntry id="A-07_o2"><text>8</text></outputEntry><outputEntry id="A-07_o3"><text>45</text></outputEntry><outputEntry id="A-07_o4"><text>"A-07"</text></outputEntry><outputEntry id="A-07_o5"><text>"Default: an analyst signs off"</text></outputEntry></rule>
    </decisionTable>
  </decision>
